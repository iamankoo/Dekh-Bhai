<Window x:Class="DekhBhai.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dekh Bhai" Height="480" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0B0C0F">

    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#3DDC84"/>
            <Setter Property="Foreground" Value="#0B0C0F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="-2" Stroke="#3DDC84" StrokeThickness="2" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E5484D"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="Button" x:Key="DurationButton">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#16181D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A2D34"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="StatusLine">
            <Setter Property="Foreground" Value="#8A8F98"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">

        <!-- IDLE -->
        <StackPanel x:Name="IdlePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="DEKH BHAI" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,28"/>
            <Button x:Name="StartSharingButton" Content="START SHARING" Style="{StaticResource PrimaryButton}" Click="StartSharingButton_Click"/>
            <TextBlock x:Name="IdleStatusText" Style="{StaticResource StatusLine}" HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"/>
        </StackPanel>

        <!-- DURATION SELECTION -->
        <StackPanel x:Name="DurationPanel" VerticalAlignment="Center" HorizontalAlignment="Stretch" Visibility="Collapsed">
            <TextBlock Text="DEKH BHAI" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="How long do you want to cast?" Foreground="#8A8F98" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <RadioButton x:Name="Duration15Radio" GroupName="Duration" IsChecked="True" Visibility="Collapsed"/>
            <Button x:Name="Duration15Button" Content="15 MINUTES" Style="{StaticResource DurationButton}" Click="DurationOption_Click" Tag="FifteenMinutes"/>
            <Button x:Name="Duration1hButton" Content="1 HOUR" Style="{StaticResource DurationButton}" Click="DurationOption_Click" Tag="OneHour"/>
            <Button x:Name="Duration5hButton" Content="5 HOURS" Style="{StaticResource DurationButton}" Click="DurationOption_Click" Tag="FiveHours"/>
            <Button x:Name="DurationUntilStoppedButton" Content="UNTIL I STOP" Style="{StaticResource DurationButton}" Click="DurationOption_Click" Tag="UntilStopped"/>

            <Button x:Name="StartButton" Content="START" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,14,0,0" Click="StartButton_Click" IsEnabled="False"/>
            <TextBlock x:Name="DurationStatusText" Style="{StaticResource StatusLine}" HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"/>
        </StackPanel>

        <!-- LIVE -->
        <StackPanel x:Name="LivePanel" VerticalAlignment="Center" HorizontalAlignment="Stretch" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Ellipse Width="10" Height="10" Fill="#E5484D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="LIVE" FontSize="20" FontWeight="Bold" Foreground="White"/>
            </StackPanel>

            <TextBlock x:Name="ElapsedText" Text="00:00:00" FontFamily="Consolas" FontSize="15" Foreground="#3DDC84"
                       HorizontalAlignment="Center" Margin="0,0,0,14"/>

            <Border Background="#16181D" BorderBrush="#2A2D34" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="QrImage" Width="96" Height="96" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Share this link:" Foreground="#8A8F98" FontSize="11.5"/>
                        <TextBox x:Name="ShareUrlBox" Margin="0,4,0,6" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                                 Background="#0B0C0F" Foreground="#3DDC84" BorderThickness="0" Padding="6" TextWrapping="Wrap" Width="220"/>
                        <Button x:Name="CopyLinkButton" Content="COPY LINK" Padding="10,5" FontSize="11.5" Click="CopyLinkButton_Click"
                                Background="#24272E" Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="CopyConfirmText" Text="Link copied" Foreground="#3DDC84" FontSize="11" Margin="0,4,0,0" Visibility="Hidden"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Shown when a viewer on the share link clicks "Remote Control" - the host must
                 explicitly Allow or Deny before that viewer gets any mouse/keyboard access. -->
            <Border x:Name="ControlRequestPanel" Background="#20301A" BorderBrush="#3DDC84" BorderThickness="1"
                    Padding="12" CornerRadius="6" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Remote control requested" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="Someone on your share link wants to control this laptop's mouse and keyboard." Foreground="#B7BCC4" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="ALLOW" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,0" Click="ControlAllowButton_Click"/>
                        <Button Content="DENY" Style="{StaticResource DangerButton}" Padding="14,6" Click="ControlDenyButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Shown while a viewer's remote control connection is active. -->
            <Border x:Name="ControlActivePanel" Background="#16181D" BorderBrush="#2A2D34" BorderThickness="1"
                    Padding="10,8" CornerRadius="6" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#3DDC84" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Remote control active" Foreground="White" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="REVOKE" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="11.5" Click="ControlRevokeButton_Click"/>
                </StackPanel>
            </Border>

            <Button x:Name="StopButton" Content="STOP SHARING" Style="{StaticResource DangerButton}" HorizontalAlignment="Center" Click="StopButton_Click"/>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Diagnostics" Foreground="#8A8F98" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock x:Name="ConnectionStatusText" Style="{StaticResource StatusLine}" Text="signaling: connecting..."/>
                <TextBlock x:Name="ViewerStatusText" Style="{StaticResource StatusLine}" Text="viewers: 0"/>
                <TextBlock x:Name="CaptureStatusText" Style="{StaticResource StatusLine}" Text="capture: starting..."/>
                <TextBlock x:Name="AudioStatusText" Style="{StaticResource StatusLine}" Text="audio: starting..."/>
            </StackPanel>
        </StackPanel>

        <!-- STOPPING -->
        <StackPanel x:Name="StoppingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="Stopping..." FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- POST-SESSION -->
        <StackPanel x:Name="PostSessionPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="DEKH BHAI" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,18"/>
            <TextBlock Text="Sharing Stopped" FontSize="16" Foreground="#8A8F98" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="Designed by Aniket" FontSize="12" Foreground="#4A4F58" HorizontalAlignment="Center" Margin="0,0,0,28"/>
            <Button x:Name="StartAgainButton" Content="START AGAIN" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="StartAgainButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
