<Application x:Class="DekhBhai.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DekhBhai.App">
    <Application.Resources>
        <ContextMenu x:Key="TrayContextMenu">
            <MenuItem Header="Open Dekh Bhai" Click="TrayOpen_Click" FontWeight="Bold"/>
            <Separator/>
            <MenuItem Header="Stop Sharing" Click="TrayStop_Click" Name="TrayStopMenuItem"/>
            <Separator/>
            <MenuItem Header="Exit" Click="TrayExit_Click"/>
        </ContextMenu>
    </Application.Resources>
</Application>