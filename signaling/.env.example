# Copy to .env for local overrides (or set these as real environment variables in production).
# Never commit an actual .env file - see .gitignore.

NODE_ENV=development
PORT=8787

# Comma-separated STUN server URLs.
STUN_URLS=stun:stun.l.google.com:19302

# TURN (optional in development - STUN-only is used if these are unset).
# TURN_URL should point at your coturn deployment, e.g. turn:turn.example.com:3478
# TURN_SECRET must match coturn's `static-auth-secret` - see docs/deployment/phase-2.md.
TURN_URL=
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

MAX_VIEWERS_PER_SESSION=25
HOST_HEARTBEAT_INTERVAL_MS=15000
HOST_HEARTBEAT_TIMEOUT_MS=45000
CLEANUP_INTERVAL_MS=10000

RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_MESSAGES=50

LOG_LEVEL=info
